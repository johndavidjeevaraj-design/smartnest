/* =====================================================
   SMARTNEST — SCI-FI BLACK + ELECTRIC BLUE
   Append to the END of app/globals.css
   Preserves existing components and layout.
   ===================================================== */

:root {
  --bg: #05070d;
  --panel: #0c111c;
  --panel-light: #121a2a;
  --text: #f2f6ff;
  --muted: #9aa8bf;
  --green: #1687ff;
  --blue: #1687ff;
  --line: rgba(160, 190, 255, 0.14);

  --sn-green: #1687ff;
  --sn-ink: #05070d;
  --sn-panel: #0c111c;
  --sn-muted: #9aa8bf;

  --sn-electric: #1687ff;
  --sn-ice: #f2f6ff;
  --sn-navy: #0d1423;
}

/* Global focus, selection and page background */
body {
  background: var(--bg);
  color: var(--text);
}

::selection {
  background: #1687ff;
  color: #ffffff;
}

button:focus-visible,
a:focus-visible,
input:focus-visible,
textarea:focus-visible,
select:focus-visible {
  outline-color: #1687ff;
}

/* Brand */
.brand-light,
.brand-symbol span,
.status-dot,
.tiny-live {
  color: #1687ff;
}

.brand-symbol span {
  background: #1687ff;
  box-shadow: 0 0 16px rgba(22, 135, 255, 0.45);
}

.status-dot,
.tiny-live {
  background: #1687ff;
  box-shadow: 0 0 12px rgba(22, 135, 255, 0.65);
}

/* Navigation */
.navbar {
  background: rgba(5, 7, 13, 0.76);
  border-bottom-color: rgba(150, 190, 255, 0.13);
}

.nav-links > a:not(.nav-cta):hover {
  color: #58adff;
}

.nav-cta {
  color: #58adff;
  border-color: rgba(22, 135, 255, 0.55);
  background: rgba(22, 135, 255, 0.06);
}

.nav-cta:hover {
  background: rgba(22, 135, 255, 0.14);
  box-shadow: 0 0 24px rgba(22, 135, 255, 0.14);
}

/* Cinematic hero */
.hero {
  background: #05070d;
}

.hero-overlay {
  background:
    linear-gradient(
      90deg,
      rgba(5, 7, 13, 0.96) 0%,
      rgba(5, 7, 13, 0.78) 38%,
      rgba(5, 7, 13, 0.23) 100%
    ),
    linear-gradient(
      0deg,
      #05070d 0%,
      transparent 24%,
      rgba(5, 7, 13, 0.15) 100%
    );
}

.hero h1 span,
.experience-copy h2 span,
.contact-copy h2 span {
  color: #58adff;
}

.hero-footnote .foot-line,
.scroll-indicator svg,
.play-icon {
  color: #58adff;
}

.foot-line {
  background: #1687ff;
}

.button-primary {
  color: #ffffff;
  background: linear-gradient(135deg, #1687ff, #0758d6);
  box-shadow: 0 6px 25px rgba(22, 135, 255, 0.17);
}

.button-primary:hover {
  background: linear-gradient(135deg, #54adff, #1687ff);
  box-shadow: 0 10px 35px rgba(22, 135, 255, 0.28);
}

.button-ghost:hover {
  border-color: #1687ff;
}

.floating-card {
  background: rgba(8, 14, 26, 0.88);
  border-color: rgba(125, 180, 255, 0.27);
  box-shadow: 0 20px 80px rgba(0, 0, 0, 0.4);
}

.floating-icon,
.control-icon {
  color: #58adff;
  border-color: rgba(22, 135, 255, 0.35);
  background: rgba(22, 135, 255, 0.09);
}

.floating-top svg,
.floating-bottom strong {
  color: #58adff;
}

/* Unified dark solutions section */
.solutions-section {
  background:
    radial-gradient(ellipse at 10% 0%, rgba(22, 135, 255, 0.09), transparent 42%),
    #080c14;
  color: #f2f6ff;
}

.dark-eyebrow {
  color: #9aa8bf;
}

.dark-eyebrow .status-dot {
  background: #1687ff;
}

.section-heading h2 span {
  color: #58adff;
}

.section-heading > p {
  color: #9aa8bf;
}

.feature-card {
  color: #f2f6ff;
  background: linear-gradient(145deg, #111a2a, #0a0f19);
  border-color: rgba(145, 180, 235, 0.15);
}

.feature-card:hover {
  border-color: rgba(22, 135, 255, 0.6);
  box-shadow: 0 15px 45px rgba(0, 72, 180, 0.14);
}

.feature-number,
.feature-card p {
  color: #9aa8bf;
}

.feature-icon {
  color: #58adff;
  border-color: rgba(22, 135, 255, 0.3);
  background: rgba(22, 135, 255, 0.1);
}

.feature-card > a {
  color: #58adff;
  border-color: rgba(22, 135, 255, 0.35);
}

/* Interactive home demo */
.experience-section {
  background:
    radial-gradient(ellipse at 75% 35%, rgba(22, 135, 255, 0.13), transparent 45%),
    #05070d;
}

.experience-points svg,
.text-link,
.panel-label,
.panel-avatar,
.range-label strong,
.temperature-control strong,
.demo-note svg {
  color: #58adff;
}

.text-link {
  border-bottom-color: rgba(22, 135, 255, 0.5);
}

.control-panel {
  background: linear-gradient(145deg, #111a2a, #080c14);
  border-color: rgba(120, 170, 240, 0.2);
}

.panel-status,
.control-row,
.demo-note {
  border-color: rgba(160, 190, 255, 0.12);
}

.room-tab:hover,
.room-tab-active {
  color: #58adff;
  border-color: rgba(22, 135, 255, 0.6);
  background: rgba(22, 135, 255, 0.1);
}

.scene-button {
  color: #a9b7ce;
  background: #101827;
  border-color: rgba(150, 180, 235, 0.15);
}

.scene-button:hover,
.scene-active {
  color: #58adff;
  border-color: rgba(22, 135, 255, 0.65);
  background: rgba(22, 135, 255, 0.1);
}

.toggle-on {
  background: #1687ff;
  border-color: #1687ff;
}

.toggle-on i {
  background: #ffffff;
}

.range-control input[type="range"] {
  background: linear-gradient(
    to right,
    #1687ff 0 var(--range-value),
    #27354a var(--range-value) 100%
  );
}

.range-control input[type="range"]::-webkit-slider-thumb {
  border-color: #58adff;
  background: #08101d;
}

.range-control input[type="range"]::-moz-range-thumb {
  border-color: #58adff;
  background: #08101d;
}

.temperature-control button {
  color: #dceaff;
  background: #111c2e;
  border-color: rgba(150, 180, 235, 0.2);
}

/* KNX technology section */
.technology-section {
  background:
    radial-gradient(ellipse at 80% 15%, rgba(22, 135, 255, 0.12), transparent 40%),
    #090e18;
  color: #f2f6ff;
}

.tech-orbit {
  border-color: rgba(22, 135, 255, 0.24);
}

.tech-core {
  color: #f2f6ff;
}

.tech-core small,
.tech-copy > p,
.tech-benefits p {
  color: #9aa8bf;
}

.tech-copy h2 span {
  color: #58adff;
}

.orbit-tag {
  color: #dceaff;
  background: #111b2c;
  border-color: rgba(130, 175, 245, 0.2);
  box-shadow: 0 8px 28px rgba(0, 0, 0, 0.2);
}

.orbit-tag svg {
  color: #58adff;
}

.benefit-check {
  color: #58adff;
  border-color: rgba(22, 135, 255, 0.4);
}

/* Gallery and other dark sections */
.visual-gallery-section {
  background:
    radial-gradient(ellipse at 8% 22%, rgba(22, 135, 255, 0.1), transparent 38%),
    #05070d;
}

.visual-gallery-section::before {
  background: rgba(22, 135, 255, 0.08);
}

.gallery-heading h2 span,
.carousel-gallery-copy h3 span,
.gallery-card-kicker span,
.gallery-index,
.gallery-card-footer > span span {
  color: #58adff;
}

.gallery-stats .stat-orb {
  color: #58adff;
  border-color: rgba(22, 135, 255, 0.28);
  background: rgba(22, 135, 255, 0.09);
}

.gallery-stats .stat-orb svg {
  color: #58adff;
}

.round-carousel-frame {
  background: radial-gradient(
    ellipse at center,
    rgba(22, 135, 255, 0.1),
    transparent 68%
  );
}

.quote-section {
  background:
    radial-gradient(ellipse at center, #101e34, #05070d 72%);
}

.quote-mark {
  color: #58adff;
}

/* Contact form */
.contact-section {
  background:
    radial-gradient(ellipse at 5% 30%, rgba(22, 135, 255, 0.08), transparent 38%),
    #070a11;
}

.contact-note-icon {
  color: #58adff;
  border-color: rgba(22, 135, 255, 0.32);
}

.form-kicker {
  color: #58adff;
}

.contact-form {
  background: #0d1320;
  border-color: rgba(140, 175, 235, 0.18);
}

.contact-form input,
.contact-form select,
.contact-form textarea {
  background: #080d17;
  border-color: #29364c;
}

.contact-form input:focus,
.contact-form select:focus,
.contact-form textarea:focus {
  border-color: #1687ff;
}

.form-success > span {
  color: #58adff;
  background: rgba(22, 135, 255, 0.12);
}

/* Footer and WhatsApp */
.footer {
  background: #04060b;
}

.footer-top-link svg,
.footer-dot {
  color: #58adff;
}

.whatsapp-float {
  color: #ffffff;
  background: #0758d6;
  border-color: #1687ff;
  box-shadow: 0 8px 35px rgba(0, 0, 0, 0.35);
}

.whatsapp-float:hover {
  background: #1687ff;
  box-shadow: 0 12px 40px rgba(22, 135, 255, 0.25);
}

/* Reduced-motion accessibility remains respected */
@media (prefers-reduced-motion: reduce) {
  .hero-image {
    animation: none !important;
  }
}