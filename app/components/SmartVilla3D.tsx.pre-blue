
"use client";

import dynamic from "next/dynamic";
import { useState } from "react";
import {
  Activity,
  Blinds,
  Check,
  ChevronDown,
  Home,
  Lightbulb,
  LockKeyhole,
  Maximize2,
  Moon,
  RotateCcw,
  Shield,
  Snowflake,
  Sun,
  Thermometer,
  Plane,
  Wifi,
} from "lucide-react";
import type { VillaSceneMode } from "./SmartVilla3DCanvas";

const VillaCanvas = dynamic(() => import("./SmartVilla3DCanvas"), {
  ssr: false,
  loading: () => (
    <div className="sv3-loading">
      <div className="sv3-loader" />
      <span>Preparing your SmartNest 3D villa…</span>
    </div>
  ),
});

type ScenePreset = "HOME" | "AWAY" | "NIGHT";

export default function SmartVilla3D() {
  const [lightsOn, setLightsOn] = useState(true);
  const [curtainsOpen, setCurtainsOpen] = useState(true);
  const [temperature, setTemperature] = useState(23);
  const [securityArmed, setSecurityArmed] = useState(false);
  const [sceneMode, setSceneMode] = useState<VillaSceneMode>("HOME");

  function applyScene(preset: ScenePreset) {
    setSceneMode(preset);

    if (preset === "HOME") {
      setLightsOn(true);
      setCurtainsOpen(true);
      setTemperature(23);
      setSecurityArmed(false);
    }

    if (preset === "AWAY") {
      setLightsOn(false);
      setCurtainsOpen(false);
      setTemperature(20);
      setSecurityArmed(true);
    }

    if (preset === "NIGHT") {
      setLightsOn(true);
      setCurtainsOpen(false);
      setTemperature(22);
      setSecurityArmed(true);
    }
  }

  function resetVilla() {
    applyScene("HOME");
  }

  return (
    <section className="sv3-section" id="smart-villa">
      <div className="sv3-container">
        <div className="sv3-heading">
          <div className="sv3-eyebrow">
            <span className="sv3-pulse" />
            INTERACTIVE KNX EXPERIENCE
          </div>

          <h2>
            Your home.
            <br />
            <span>Under your control.</span>
          </h2>

          <p>
            Explore a 3D smart villa and experience how lighting, curtains,
            climate and security work together through intelligent automation.
          </p>
        </div>

        <div className="sv3-dashboard">
          <div className="sv3-viewport">
            <div className="sv3-viewport-top">
              <div className="sv3-live">
                <span className="sv3-pulse" />
                3D LIVE VIEW
              </div>
              <div className="sv3-view-hint">
                <Maximize2 size={13} />
                Drag to rotate · Scroll to zoom
              </div>
            </div>

            <div className="sv3-canvas">
              <VillaCanvas
                lightsOn={lightsOn}
                curtainsOpen={curtainsOpen}
                temperature={temperature}
                securityArmed={securityArmed}
                sceneMode={sceneMode}
              />
            </div>

            <div className="sv3-viewport-bottom">
              <div>
                <span className="sv3-status-dot" />
                SMART VILLA SIMULATION
              </div>
              <span>KNX CONTROL CONCEPT</span>
            </div>
          </div>

          <aside className="sv3-controls">
            <div className="sv3-controls-header">
              <div>
                <span className="sv3-mini-label">SMART HOME</span>
                <h3>Control centre</h3>
              </div>
              <div className="sv3-connect-icon">
                <Wifi size={18} />
              </div>
            </div>

            <div className="sv3-home-status">
              <div className="sv3-status-icon">
                <Home size={19} />
              </div>
              <div className="sv3-status-copy">
                <strong>Villa system</strong>
                <span>Demo controls active</span>
              </div>
              <span className="sv3-online">
                <span />
                ONLINE
              </span>
            </div>

            <div className="sv3-divider" />

            <div className="sv3-section-label">QUICK SCENES</div>

            <div className="sv3-scenes">
              <button
                className={`sv3-scene ${sceneMode === "HOME" ? "active" : ""}`}
                onClick={() => applyScene("HOME")}
                type="button"
              >
                <Sun size={18} />
                <span>Home</span>
              </button>

              <button
                className={`sv3-scene ${sceneMode === "AWAY" ? "active" : ""}`}
                onClick={() => applyScene("AWAY")}
                type="button"
              >
                <Plane size={18} />
                <span>Away</span>
              </button>

              <button
                className={`sv3-scene ${sceneMode === "NIGHT" ? "active" : ""}`}
                onClick={() => applyScene("NIGHT")}
                type="button"
              >
                <Moon size={18} />
                <span>Night</span>
              </button>
            </div>

            <div className="sv3-divider" />

            <div className="sv3-section-label">ROOM AUTOMATION</div>

            <div className="sv3-control-row">
              <div className={`sv3-control-icon ${lightsOn ? "lit" : ""}`}>
                <Lightbulb size={19} />
              </div>
              <div className="sv3-control-copy">
                <strong>Lighting</strong>
                <span>{lightsOn ? "Lights switched on" : "All lights off"}</span>
              </div>
              <button
                type="button"
                className={`sv3-toggle ${lightsOn ? "on" : ""}`}
                aria-label="Toggle villa lighting"
                aria-pressed={lightsOn}
                onClick={() => {
                  setLightsOn((value) => !value);
                  setSceneMode("CUSTOM");
                }}
              >
                <span />
              </button>
            </div>

            <div className="sv3-control-row">
              <div className={`sv3-control-icon ${curtainsOpen ? "lit" : ""}`}>
                <Blinds size={19} />
              </div>
              <div className="sv3-control-copy">
                <strong>Curtains</strong>
                <span>{curtainsOpen ? "Open · Daylight" : "Closed · Privacy"}</span>
              </div>
              <button
                type="button"
                className={`sv3-toggle ${curtainsOpen ? "on" : ""}`}
                aria-label="Toggle villa curtains"
                aria-pressed={curtainsOpen}
                onClick={() => {
                  setCurtainsOpen((value) => !value);
                  setSceneMode("CUSTOM");
                }}
              >
                <span />
              </button>
            </div>

            <div className="sv3-divider" />

            <div className="sv3-temp-heading">
              <div className="sv3-control-icon climate">
                <Thermometer size={19} />
              </div>
              <div className="sv3-control-copy">
                <strong>Climate control</strong>
                <span>Target temperature</span>
              </div>
              <div className="sv3-temperature">
                {temperature}°
                <span>C</span>
              </div>
            </div>

            <input
              className="sv3-range"
              type="range"
              min="16"
              max="30"
              step="1"
              value={temperature}
              aria-label="Target temperature in Celsius"
              style={{
                background: `linear-gradient(to right, #29f0c4 ${
                  ((temperature - 16) / 14) * 100
                }%, rgba(255,255,255,.12) ${
                  ((temperature - 16) / 14) * 100
                }%)`,
              }}
              onChange={(event) => {
                setTemperature(Number(event.target.value));
                setSceneMode("CUSTOM");
              }}
            />

            <div className="sv3-range-labels">
              <span>16°C</span>
              <span>COMFORT RANGE</span>
              <span>30°C</span>
            </div>

            <div className="sv3-divider" />

            <div className="sv3-control-row">
              <div className={`sv3-control-icon ${securityArmed ? "secure" : ""}`}>
                {securityArmed ? (
                  <LockKeyhole size={19} />
                ) : (
                  <Shield size={19} />
                )}
              </div>
              <div className="sv3-control-copy">
                <strong>Security system</strong>
                <span>
                  {securityArmed ? "Protection armed" : "Protection disarmed"}
                </span>
              </div>
              <button
                type="button"
                className={`sv3-toggle ${securityArmed ? "on" : ""}`}
                aria-label="Toggle villa security"
                aria-pressed={securityArmed}
                onClick={() => {
                  setSecurityArmed((value) => !value);
                  setSceneMode("CUSTOM");
                }}
              >
                <span />
              </button>
            </div>

            <button
              type="button"
              className="sv3-reset"
              onClick={resetVilla}
            >
              <RotateCcw size={14} />
              Reset to Home scene
            </button>

            <div className="sv3-demo-note">
              <Activity size={15} />
              <span>
                Interactive simulation. Physical KNX devices are not connected.
              </span>
            </div>
          </aside>
        </div>

        <div className="sv3-feature-strip">
          <div>
            <Lightbulb size={18} />
            <span>Intelligent lighting</span>
            <Check size={14} className="sv3-feature-check" />
          </div>
          <div>
            <Blinds size={18} />
            <span>Automated shading</span>
            <Check size={14} className="sv3-feature-check" />
          </div>
          <div>
            <Snowflake size={18} />
            <span>Climate comfort</span>
            <Check size={14} className="sv3-feature-check" />
          </div>
          <div>
            <Shield size={18} />
            <span>Smart security</span>
            <Check size={14} className="sv3-feature-check" />
          </div>
        </div>
      </div>

      <style jsx>{`
        .sv3-section {
          position: relative;
          overflow: hidden;
          padding: 112px 24px;
          color: #f5faf7;
          background:
            radial-gradient(ellipse at 50% 15%, rgba(41, 240, 196, 0.09), transparent 48%),
            #080d0c;
          font-family: inherit;
        }
        .sv3-container {
          max-width: 1240px;
          margin: 0 auto;
        }
        .sv3-heading {
          max-width: 700px;
          margin: 0 auto 48px;
          text-align: center;
        }
        .sv3-eyebrow {
          display: flex;
          justify-content: center;
          align-items: center;
          gap: 9px;
          margin-bottom: 19px;
          color: #29f0c4;
          font-size: 11px;
          font-weight: 800;
          letter-spacing: 2px;
        }
        .sv3-pulse,
        .sv3-online > span {
          width: 7px;
          height: 7px;
          display: inline-block;
          border-radius: 50%;
          background: #29f0c4;
          box-shadow: 0 0 12px rgba(41, 240, 196, 0.75);
        }
        .sv3-heading h2 {
          margin: 0;
          font-size: clamp(36px, 5vw, 62px);
          line-height: 1.05;
          letter-spacing: -2.5px;
          font-weight: 750;
        }
        .sv3-heading h2 span {
          color: #29f0c4;
        }
        .sv3-heading p {
          max-width: 610px;
          margin: 20px auto 0;
          color: #9aa9a2;
          font-size: 15px;
          line-height: 1.8;
        }
        .sv3-dashboard {
          display: grid;
          grid-template-columns: minmax(0, 1.65fr) minmax(310px, 0.85fr);
          overflow: hidden;
          border: 1px solid rgba(177, 217, 201, 0.15);
          border-radius: 24px;
          background: #0d1512;
          box-shadow: 0 35px 100px rgba(0, 0, 0, 0.35);
        }
        .sv3-viewport {
          min-width: 0;
          display: flex;
          flex-direction: column;
          background:
            radial-gradient(ellipse at 48% 45%, rgba(41, 240, 196, 0.09), transparent 50%),
            #09110f;
        }
        .sv3-viewport-top,
        .sv3-viewport-bottom {
          min-height: 57px;
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 12px;
          padding: 0 20px;
          color: #a2b1aa;
          font-size: 10px;
          letter-spacing: 1px;
        }
        .sv3-viewport-top {
          border-bottom: 1px solid rgba(255, 255, 255, 0.07);
        }
        .sv3-live,
        .sv3-view-hint,
        .sv3-viewport-bottom > div {
          display: flex;
          align-items: center;
          gap: 9px;
        }
        .sv3-live {
          color: #29f0c4;
          font-weight: 800;
        }
        .sv3-view-hint {
          font-size: 10px;
          letter-spacing: 0;
        }
        .sv3-canvas {
          height: 520px;
          min-height: 360px;
          position: relative;
        }
        .sv3-canvas canvas {
          display: block;
          outline: none;
          touch-action: pan-y;
        }
        .sv3-viewport-bottom {
          min-height: 48px;
          border-top: 1px solid rgba(255, 255, 255, 0.07);
          font-size: 9px;
          letter-spacing: 1.1px;
        }
        .sv3-status-dot {
          width: 6px;
          height: 6px;
          display: inline-block;
          border-radius: 50%;
          background: #29f0c4;
        }
        .sv3-controls {
          min-width: 0;
          padding: 25px 22px 20px;
          border-left: 1px solid rgba(177, 217, 201, 0.12);
          background: linear-gradient(155deg, #111c17, #0b110e 75%);
        }
        .sv3-controls-header {
          display: flex;
          justify-content: space-between;
          align-items: center;
          margin-bottom: 23px;
        }
        .sv3-mini-label,
        .sv3-section-label {
          color: #81938a;
          font-size: 9px;
          font-weight: 800;
          letter-spacing: 1.7px;
        }
        .sv3-controls-header h3 {
          margin: 6px 0 0;
          font-size: 22px;
          letter-spacing: -0.7px;
        }
        .sv3-connect-icon {
          width: 39px;
          height: 39px;
          display: grid;
          place-items: center;
          color: #29f0c4;
          border: 1px solid rgba(41, 240, 196, 0.2);
          border-radius: 12px;
          background: rgba(41, 240, 196, 0.07);
        }
        .sv3-home-status {
          display: flex;
          align-items: center;
          gap: 11px;
          padding: 13px 12px;
          border: 1px solid rgba(255, 255, 255, 0.07);
          border-radius: 13px;
          background: rgba(255, 255, 255, 0.025);
        }
        .sv3-status-icon {
          width: 38px;
          height: 38px;
          display: grid;
          flex-shrink: 0;
          place-items: center;
          color: #29f0c4;
          border-radius: 11px;
          background: rgba(41, 240, 196, 0.09);
        }
        .sv3-status-copy,
        .sv3-control-copy {
          display: flex;
          min-width: 0;
          flex-direction: column;
          gap: 5px;
        }
        .sv3-status-copy strong,
        .sv3-control-copy strong {
          color: #edf7f1;
          font-size: 12px;
          font-weight: 700;
        }
        .sv3-status-copy > span,
        .sv3-control-copy > span {
          color: #84968c;
          font-size: 10px;
        }
        .sv3-online {
          display: flex;
          align-items: center;
          gap: 5px;
          margin-left: auto;
          color: #29f0c4;
          font-size: 8px;
          font-weight: 800;
          letter-spacing: 0.7px;
        }
        .sv3-online > span {
          width: 5px;
          height: 5px;
        }
        .sv3-divider {
          height: 1px;
          margin: 20px 0;
          background: rgba(255, 255, 255, 0.08);
        }
        .sv3-section-label {
          margin-bottom: 13px;
        }
        .sv3-scenes {
          display: grid;
          grid-template-columns: repeat(3, minmax(0, 1fr));
          gap: 8px;
        }
        .sv3-scene {
          display: flex;
          min-width: 0;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          gap: 8px;
          padding: 13px 5px 11px;
          border: 1px solid rgba(255, 255, 255, 0.09);
          border-radius: 12px;
          color: #9aaba1;
          background: rgba(255, 255, 255, 0.025);
          font: inherit;
          font-size: 10px;
          cursor: pointer;
          transition: 180ms ease;
        }
        .sv3-scene:hover,
        .sv3-scene.active {
          color: #29f0c4;
          border-color: rgba(41, 240, 196, 0.5);
          background: rgba(41, 240, 196, 0.085);
        }
        .sv3-control-row {
          display: flex;
          align-items: center;
          gap: 11px;
          min-height: 56px;
        }
        .sv3-control-icon {
          width: 38px;
          height: 38px;
          display: grid;
          flex-shrink: 0;
          place-items: center;
          color: #93a39a;
          border: 1px solid rgba(255, 255, 255, 0.075);
          border-radius: 11px;
          background: rgba(255, 255, 255, 0.035);
        }
        .sv3-control-icon.lit,
        .sv3-control-icon.climate {
          color: #29f0c4;
          border-color: rgba(41, 240, 196, 0.15);
          background: rgba(41, 240, 196, 0.08);
        }
        .sv3-control-icon.secure {
          color: #ff728b;
          border-color: rgba(255, 72, 105, 0.2);
          background: rgba(255, 72, 105, 0.08);
        }
        .sv3-control-copy {
          flex: 1;
        }
        .sv3-toggle {
          width: 39px;
          height: 23px;
          display: flex;
          flex-shrink: 0;
          align-items: center;
          padding: 3px;
          border: 1px solid rgba(255, 255, 255, 0.1);
          border-radius: 99px;
          background: #2b3731;
          cursor: pointer;
          transition: 180ms ease;
        }
        .sv3-toggle > span {
          width: 15px;
          height: 15px;
          border-radius: 50%;
          background: #a0afa6;
          transition: transform 180ms ease, background 180ms ease;
        }
        .sv3-toggle.on {
          border-color: #29f0c4;
          background: #147b65;
        }
        .sv3-toggle.on > span {
          transform: translateX(15px);
          background: #ffffff;
        }
        .sv3-temp-heading {
          display: flex;
          align-items: center;
          gap: 11px;
        }
        .sv3-temperature {
          margin-left: auto;
          color: #f4faf6;
          font-size: 27px;
          font-weight: 750;
          letter-spacing: -1px;
        }
        .sv3-temperature span {
          margin-left: 2px;
          color: #9baaa1;
          font-size: 12px;
          font-weight: 500;
        }
        .sv3-range {
          display: block;
          width: 100%;
          height: 4px;
          margin: 19px 0 10px;
          border: 0;
          border-radius: 99px;
          appearance: none;
          cursor: pointer;
        }
        .sv3-range::-webkit-slider-thumb {
          width: 14px;
          height: 14px;
          border: 3px solid #0d1512;
          border-radius: 50%;
          appearance: none;
          background: #29f0c4;
          box-shadow: 0 0 0 1px #29f0c4;
        }
        .sv3-range::-moz-range-thumb {
          width: 10px;
          height: 10px;
          border: 3px solid #0d1512;
          border-radius: 50%;
          background: #29f0c4;
          box-shadow: 0 0 0 1px #29f0c4;
        }
        .sv3-range-labels {
          display: flex;
          justify-content: space-between;
          color: #7f9086;
          font-size: 9px;
        }
        .sv3-reset {
          width: 100%;
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 8px;
          margin-top: 21px;
          padding: 11px;
          border: 1px solid rgba(41, 240, 196, 0.22);
          border-radius: 10px;
          color: #29f0c4;
          background: rgba(41, 240, 196, 0.045);
          font: inherit;
          font-size: 11px;
          cursor: pointer;
          transition: 180ms ease;
        }
        .sv3-reset:hover {
          background: rgba(41, 240, 196, 0.12);
        }
        .sv3-demo-note {
          display: flex;
          align-items: flex-start;
          gap: 8px;
          margin-top: 16px;
          color: #7f9086;
          font-size: 10px;
          line-height: 1.6;
        }
        .sv3-demo-note :global(svg) {
          flex-shrink: 0;
          color: #29f0c4;
        }
        .sv3-feature-strip {
          display: grid;
          grid-template-columns: repeat(4, minmax(0, 1fr));
          gap: 12px;
          margin-top: 18px;
        }
        .sv3-feature-strip > div {
          display: flex;
          align-items: center;
          gap: 10px;
          min-width: 0;
          padding: 17px;
          border: 1px solid rgba(177, 217, 201, 0.12);
          border-radius: 13px;
          color: #a9b8af;
          background: rgba(255, 255, 255, 0.025);
          font-size: 11px;
        }
        .sv3-feature-strip > div > :global(svg:first-child) {
          flex-shrink: 0;
          color: #29f0c4;
        }
        .sv3-feature-check {
          flex-shrink: 0;
          margin-left: auto;
          color: #29f0c4;
        }
        .sv3-loading {
          height: 100%;
          min-height: 360px;
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          gap: 15px;
          color: #29f0c4;
          font-size: 12px;
        }
        .sv3-loader {
          width: 30px;
          height: 30px;
          border: 2px solid rgba(41, 240, 196, 0.2);
          border-top-color: #29f0c4;
          border-radius: 50%;
          animation: sv3-spin 0.8s linear infinite;
        }
        @keyframes sv3-spin {
          to { transform: rotate(360deg); }
        }
        @media (max-width: 960px) {
          .sv3-dashboard {
            grid-template-columns: minmax(0, 1fr);
          }
          .sv3-controls {
            border-top: 1px solid rgba(177, 217, 201, 0.12);
            border-left: 0;
            padding: 24px;
          }
          .sv3-canvas {
            height: 490px;
          }
          .sv3-feature-strip {
            grid-template-columns: repeat(2, minmax(0, 1fr));
          }
        }
        @media (max-width: 560px) {
          .sv3-section {
            padding: 75px 14px;
          }
          .sv3-heading {
            margin-bottom: 30px;
          }
          .sv3-heading h2 {
            letter-spacing: -1.6px;
          }
          .sv3-heading p {
            font-size: 13px;
          }
          .sv3-dashboard {
            border-radius: 17px;
          }
          .sv3-viewport-top,
          .sv3-viewport-bottom {
            padding: 0 12px;
          }
          .sv3-view-hint {
            font-size: 9px;
          }
          .sv3-canvas {
            height: 360px;
            min-height: 320px;
          }
          .sv3-controls {
            padding: 21px 15px;
          }
          .sv3-feature-strip {
            gap: 8px;
          }
          .sv3-feature-strip > div {
            gap: 7px;
            padding: 12px 9px;
            font-size: 10px;
          }
        }
      `}</style>
    </section>
  );
}
