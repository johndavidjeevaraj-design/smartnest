
"use client";

import { Canvas } from "@react-three/fiber";
import { ContactShadows, OrbitControls } from "@react-three/drei";

export type BriefcaseMode = "HOME" | "AWAY" | "NIGHT" | "CUSTOM";

interface Props {
  lightsOn: boolean;
  curtainsOpen: boolean;
  temperature: number;
  securityArmed: boolean;
  rgbColor: string;
  mode: BriefcaseMode;
  onLights: () => void;
  onCurtains: () => void;
  onSecurity: () => void;
  onColor: (color: string) => void;
}

const colorWheel = [
  "#ff3030", "#ff7028", "#ffd52a", "#a9ff30",
  "#29f0c4", "#28cfff", "#3678ff", "#743bff",
  "#bd35ff", "#ff38b9", "#ff4c76", "#ffffff",
];

function Part({
  position,
  size,
  color,
  emissive = "#000000",
  glow = 0,
  metalness = 0,
  roughness = 0.65,
  onClick,
}: {
  position: [number, number, number];
  size: [number, number, number];
  color: string;
  emissive?: string;
  glow?: number;
  metalness?: number;
  roughness?: number;
  onClick?: () => void;
}) {
  return (
    <mesh
      position={position}
      castShadow
      receiveShadow
      onClick={onClick ? (event) => {
        event.stopPropagation();
        onClick();
      } : undefined}
    >
      <boxGeometry args={size} />
      <meshStandardMaterial
        color={color}
        emissive={emissive}
        emissiveIntensity={glow}
        metalness={metalness}
        roughness={roughness}
      />
    </mesh>
  );
}

function VillaDisplay({
  lightsOn,
  curtainsOpen,
  temperature,
  securityArmed,
  rgbColor,
}: Pick<Props, "lightsOn" | "curtainsOpen" | "temperature" | "securityArmed" | "rgbColor">) {
  const lightGlow = lightsOn ? 2.4 : 0.08;
  const warm = lightsOn ? rgbColor : "#344640";
  const climateColor =
    temperature < 21 ? "#65cfff" :
    temperature > 25 ? "#ff805f" : "#29f0c4";

  return (
    <group>
      {/* Display bezel and screen */}
      <Part
        position={[0, 2.27, -1.32]}
        size={[5.65, 3.35, 0.18]}
        color="#111614"
        metalness={0.65}
      />
      <Part
        position={[0, 2.28, -1.215]}
        size={[5.39, 3.08, 0.035]}
        color="#192622"
        emissive="#0c201a"
        glow={0.35}
        roughness={0.3}
      />

      {/* Architectural miniature, set inside the display */}
      <Part
        position={[0, 1.16, -1.13]}
        size={[4.95, 0.09, 0.72]}
        color="#344640"
      />

      {/* Lower storey */}
      <Part
        position={[-1.2, 1.66, -1.12]}
        size={[1.78, 0.93, 0.36]}
        color="#b8c4ba"
      />
      <Part
        position={[0.78, 1.66, -1.12]}
        size={[2.12, 0.93, 0.36]}
        color="#d2d2c7"
      />

      {/* Upper storey */}
      <Part
        position={[-0.76, 2.52, -1.12]}
        size={[2.25, 0.75, 0.36]}
        color="#d8ddd4"
      />
      <Part
        position={[1.45, 2.52, -1.12]}
        size={[1.55, 0.75, 0.36]}
        color="#aebbb1"
      />

      {/* Roof slabs and modern overhang */}
      <Part
        position={[-0.75, 2.96, -1.12]}
        size={[2.52, 0.1, 0.65]}
        color="#303c37"
        metalness={0.3}
      />
      <Part
        position={[1.48, 2.96, -1.12]}
        size={[1.85, 0.1, 0.65]}
        color="#252f2a"
        metalness={0.3}
      />

      {/* Warm glazed windows */}
      <Part
        position={[-1.65, 1.7, -0.91]}
        size={[0.65, 0.58, 0.035]}
        color={warm}
        emissive={lightsOn ? rgbColor : "#000000"}
        glow={lightGlow}
        roughness={0.2}
      />
      <Part
        position={[-0.72, 1.7, -0.91]}
        size={[0.65, 0.58, 0.035]}
        color={warm}
        emissive={lightsOn ? rgbColor : "#000000"}
        glow={lightGlow}
        roughness={0.2}
      />
      <Part
        position={[0.32, 1.7, -0.91]}
        size={[0.62, 0.58, 0.035]}
        color={warm}
        emissive={lightsOn ? rgbColor : "#000000"}
        glow={lightGlow}
        roughness={0.2}
      />
      <Part
        position={[1.03, 2.52, -0.91]}
        size={[0.58, 0.48, 0.035]}
        color={warm}
        emissive={lightsOn ? rgbColor : "#000000"}
        glow={lightGlow}
        roughness={0.2}
      />
      <Part
        position={[1.9, 2.52, -0.91]}
        size={[0.45, 0.48, 0.035]}
        color={warm}
        emissive={lightsOn ? rgbColor : "#000000"}
        glow={lightGlow}
        roughness={0.2}
      />

      {/* Motorised curtains, visibly slide inward/outward */}
      <Part
        position={curtainsOpen ? [-1.83, 2.5, -0.875] : [-1.46, 2.5, -0.875]}
        size={[curtainsOpen ? 0.13 : 0.47, 0.55, 0.045]}
        color="#29a88e"
        emissive="#0d4d40"
        glow={curtainsOpen ? 0.15 : 0.5}
      />
      <Part
        position={curtainsOpen ? [-0.91, 2.5, -0.875] : [-1.0, 2.5, -0.875]}
        size={[curtainsOpen ? 0.13 : 0.47, 0.55, 0.045]}
        color="#168d77"
        emissive="#0d4d40"
        glow={curtainsOpen ? 0.15 : 0.5}
      />

      {/* Front entrance */}
      <Part
        position={[2.15, 1.55, -0.91]}
        size={[0.34, 0.72, 0.045]}
        color="#785a43"
      />
      <Part
        position={[2.25, 1.55, -0.875]}
        size={[0.035, 0.055, 0.025]}
        color="#e5d0a4"
        metalness={0.7}
      />

      {/* Garden and pathway lights */}
      {[-1.8, -0.8, 0.4, 1.4, 2.15].map((x, index) => (
        <group key={index} position={[x, 1.28, -0.78]}>
          <mesh>
            <sphereGeometry args={[0.055, 16, 16]} />
            <meshStandardMaterial
              color={lightsOn ? "#ffe3a6" : "#46554e"}
              emissive={lightsOn ? "#ffbf60" : "#000000"}
              emissiveIntensity={lightsOn ? 2 : 0}
            />
          </mesh>
        </group>
      ))}

      {/* Climate and security indicators on the miniature */}
      <Part
        position={[2.28, 2.82, -0.87]}
        size={[0.09, 0.09, 0.035]}
        color={climateColor}
        emissive={climateColor}
        glow={1.8}
      />
      <Part
        position={[2.45, 1.25, -0.78]}
        size={[0.09, 0.09, 0.035]}
        color={securityArmed ? "#ff4269" : "#29f0c4"}
        emissive={securityArmed ? "#ff1744" : "#29f0c4"}
        glow={1.8}
      />
    </group>
  );
}

function BriefcaseModel(props: Props) {
  return (
    <>
      <color attach="background" args={["#101412"]} />
      <ambientLight intensity={1.3} />
      <directionalLight
        position={[4, 9, 6]}
        intensity={2.5}
        castShadow
      />
      <pointLight position={[-4, 4, -2]} color="#29f0c4" intensity={1.1} />

      {/* Case body: red, like the reference demonstration kit */}
      <Part
        position={[0, 0.22, 0.65]}
        size={[6.1, 0.42, 3.65]}
        color="#e52430"
        metalness={0.28}
        roughness={0.4}
      />

      {/* Aluminium edge rails */}
      <Part position={[0, 0.45, 2.48]} size={[5.95, 0.09, 0.08]} color="#c2c9c5" metalness={0.85} />
      <Part position={[0, 0.45, -1.18]} size={[5.95, 0.09, 0.08]} color="#c2c9c5" metalness={0.85} />
      <Part position={[-3.02, 0.45, 0.65]} size={[0.08, 0.09, 3.55]} color="#c2c9c5" metalness={0.85} />
      <Part position={[3.02, 0.45, 0.65]} size={[0.08, 0.09, 3.55]} color="#c2c9c5" metalness={0.85} />

      {/* Rear raised lid, screen and villa */}
      <Part
        position={[0, 2.15, -1.18]}
        size={[5.92, 3.58, 0.17]}
        color="#252d29"
        metalness={0.7}
      />
      <VillaDisplay {...props} />

      {/* Hinge line */}
      <Part
        position={[0, 0.55, -1.13]}
        size={[5.7, 0.13, 0.18]}
        color="#8e9a93"
        metalness={0.85}
      />

      {/* Four physical-style switch modules */}
      <Part
        position={[-2.05, 0.49, 0.0]}
        size={[1.18, 0.12, 1.02]}
        color="#242a28"
        metalness={0.3}
        onClick={props.onLights}
      />
      <Part
        position={[-2.05, 0.57, 0.0]}
        size={[1.08, 0.055, 0.91]}
        color={props.lightsOn ? "#29f0c4" : "#707c75"}
        emissive={props.lightsOn ? "#29f0c4" : "#000000"}
        glow={props.lightsOn ? 0.35 : 0}
        onClick={props.onLights}
      />

      <Part
        position={[-0.63, 0.49, 0.0]}
        size={[1.18, 0.12, 1.02]}
        color="#d0c5b3"
        metalness={0.25}
        onClick={props.onCurtains}
      />
      <Part
        position={[-0.63, 0.57, 0.0]}
        size={[1.06, 0.055, 0.9]}
        color={props.curtainsOpen ? "#29f0c4" : "#8c9188"}
        emissive={props.curtainsOpen ? "#29f0c4" : "#000000"}
        glow={props.curtainsOpen ? 0.28 : 0}
        onClick={props.onCurtains}
      />

      <Part
        position={[-2.05, 0.49, 1.32]}
        size={[1.18, 0.12, 0.72]}
        color="#c7b9a3"
        metalness={0.2}
        onClick={props.onSecurity}
      />
      <Part
        position={[-2.05, 0.57, 1.32]}
        size={[1.06, 0.055, 0.62]}
        color={props.securityArmed ? "#ff4269" : "#e1d7c6"}
        emissive={props.securityArmed ? "#ff1744" : "#000000"}
        glow={props.securityArmed ? 0.5 : 0}
        onClick={props.onSecurity}
      />

      <Part
        position={[-0.63, 0.49, 1.32]}
        size={[1.18, 0.12, 0.72]}
        color="#202624"
        metalness={0.4}
        onClick={() => props.onColor(
          colorWheel[(colorWheel.indexOf(props.rgbColor) + 1) % colorWheel.length]
        )}
      />
      <Part
        position={[-0.63, 0.57, 1.32]}
        size={[1.06, 0.055, 0.62]}
        color={props.rgbColor}
        emissive={props.rgbColor}
        glow={0.3}
        onClick={() => props.onColor(
          colorWheel[(colorWheel.indexOf(props.rgbColor) + 1) % colorWheel.length]
        )}
      />

      {/* Touchscreen body at the right side of the red control deck */}
      <Part
        position={[1.72, 0.49, 0.73]}
        size={[1.92, 0.12, 2.55]}
        color="#111714"
        metalness={0.5}
      />
      <Part
        position={[1.72, 0.57, 0.73]}
        size={[1.78, 0.045, 2.4]}
        color="#18251f"
        emissive="#0c3328"
        glow={0.18}
        roughness={0.25}
      />

      {/* Touchscreen colour wheel */}
      {colorWheel.map((color, index) => {
        const angle = (index / colorWheel.length) * Math.PI * 2;
        return (
          <mesh
            key={color}
            position={[
              1.72 + Math.cos(angle) * 0.48,
              0.61,
              0.62 + Math.sin(angle) * 0.48,
            ]}
            onClick={(event) => {
              event.stopPropagation();
              props.onColor(color);
            }}
          >
            <cylinderGeometry args={[0.105, 0.105, 0.035, 20]} />
            <meshStandardMaterial
              color={color}
              emissive={color}
              emissiveIntensity={props.rgbColor === color ? 1.3 : 0.15}
            />
          </mesh>
        );
      })}

      <mesh position={[1.72, 0.615, 0.62]}>
        <cylinderGeometry args={[0.21, 0.21, 0.04, 28]} />
        <meshStandardMaterial
          color={props.rgbColor}
          emissive={props.rgbColor}
          emissiveIntensity={1.1}
        />
      </mesh>

      {/* Climate slider and security status on touchscreen */}
      <Part
        position={[1.72, 0.61, 1.55]}
        size={[1.2, 0.025, 0.12]}
        color="#44544b"
      />
      <Part
        position={[
          1.72 + ((props.temperature - 16) / 14 - 0.5) * 1.1,
          0.64,
          1.55,
        ]}
        size={[0.12, 0.055, 0.17]}
        color="#29f0c4"
        emissive="#29f0c4"
        glow={0.6}
      />
      <Part
        position={[1.25, 0.62, 1.94]}
        size={[0.1, 0.035, 0.1]}
        color={props.securityArmed ? "#ff4269" : "#29f0c4"}
        emissive={props.securityArmed ? "#ff1744" : "#29f0c4"}
        glow={1.2}
      />

      {/* Carry handle and latches */}
      <Part
        position={[0, 0.02, 2.56]}
        size={[1.05, 0.15, 0.14]}
        color="#c6cfca"
        metalness={0.9}
      />
      {[-2.35, 2.35].map((x) => (
        <Part
          key={x}
          position={[x, 0.47, 2.51]}
          size={[0.32, 0.18, 0.08]}
          color="#d5ddd7"
          metalness={0.9}
        />
      ))}

      <ContactShadows position={[0, -0.04, 0.6]} opacity={0.45} scale={12} blur={2.5} />

      <OrbitControls
        makeDefault
        target={[0, 1.45, 0.4]}
        enablePan
        enableZoom
        enableRotate
        minDistance={7}
        maxDistance={16}
        minPolarAngle={0.25}
        maxPolarAngle={1.48}
        enableDamping
        dampingFactor={0.08}
      />
    </>
  );
}

export default function SmartNestBriefcaseScene(props: Props) {
  return (
    <Canvas
      shadows
      dpr={[1, 1.6]}
      camera={{ position: [8, 6.5, 10], fov: 38 }}
      gl={{ antialias: true, powerPreference: "high-performance" }}
    >
      <BriefcaseModel {...props} />
    </Canvas>
  );
}
